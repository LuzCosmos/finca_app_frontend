# Environment for frontend (should match backend ENVIRONMENT variable)
ENVIRONMENT=develop

# Frontend port
FRONTEND_PORT=80
API_BASE_URL=/api/v1
BACKEND_URL=http://finca_app_backend:23000

# Pesa Rice Lake 920i — id lógico de la báscula (debe coincidir con BRIDGE_DEVICE_ID del scale bridge)
SCALE_DEVICE_ID=default-scale