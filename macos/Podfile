platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def finca_merge_runner_pod_xcconfigs!(macos_dir)
  require 'xcodeproj'

  runner_project_path = File.join(macos_dir, 'Runner.xcodeproj')
  project = Xcodeproj::Project.open(runner_project_path)

  config_suffix = { 'Debug' => 'debug', 'Release' => 'release', 'Profile' => 'profile' }
  runner_extra_includes = [
    '#include "../../../Flutter/ephemeral/Flutter-Generated.xcconfig"',
    '#include "../../../Runner/Configs/Warnings.xcconfig"',
    '#include "../../../Runner/Configs/AppInfo.xcconfig"',
  ]

  config_suffix.each do |config_name, suffix|
    pods_rel = "Pods/Target Support Files/Pods-Runner/Pods-Runner.#{suffix}.xcconfig"
    pods_abs = File.join(macos_dir, pods_rel)
    next unless File.exist?(pods_abs)

    body = File.read(pods_abs)
    runner_extra_includes.each do |line|
      body += "\n#{line}" unless body.include?(line)
    end
    File.write(pods_abs, body.end_with?("\n") ? body : "#{body}\n")

    pods_ref = project.files.find { |f| f.path&.end_with?("Pods-Runner.#{suffix}.xcconfig") }
    next unless pods_ref

    project.targets.each do |native_target|
      next unless native_target.name == 'Runner'

      native_target.build_configurations.each do |build_config|
        next unless build_config.name == config_name

        build_config.base_configuration_reference = pods_ref
      end
    end
  end

  project.save
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # sqlite3.c (amalgamation del pod): advertencias de Clang en código ajeno al proyecto.
    if target.name == 'sqlite3'
      additions = %w[
        -Wno-ambiguous-macro
        -Wno-shorten-64-to-32
        -Wno-comma
        -Wno-unreachable-code
      ]
      target.build_configurations.each do |config|
        flags = config.build_settings['OTHER_CFLAGS']
        config.build_settings['OTHER_CFLAGS'] =
          case flags
          when nil, ''
            "$(inherited) #{additions.join(' ')}"
          when Array
            (flags + additions).uniq
          else
            "#{flags} #{additions.join(' ')}"
          end
      end
    end
  end

  finca_merge_runner_pod_xcconfigs!(File.dirname(File.realpath(__FILE__)))
end
